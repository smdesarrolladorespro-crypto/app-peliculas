# Copia este archivo a .env y ajusta los valores (npm start lo lee automáticamente).
PORT=3000
NODE_ENV=development

# OBLIGATORIO en producción: cadena larga y aleatoria (p. ej. `openssl rand -hex 48`).
# En desarrollo, si no la defines, se genera y guarda en data/.jwt_secret.
JWT_SECRET=

# Administrador inicial (se crea solo si no existe ningún administrador).
# Si no defines la contraseña, se genera una aleatoria y se imprime UNA vez en la consola.
ADMIN_EMAIL=admin@cineplus.local
ADMIN_PASSWORD=

# TMDB (opcional): clave API v3 o "Read Access Token" v4.
# Solo aporta metadatos (póster, sinopsis, calificación). NO otorga derechos de reproducción.
TMDB_API_KEY=

# OPCIONAL. Los dominios autorizados se gestionan desde el panel de administración (pestaña Fuentes).
# Aquí puedes dejar algunos fijos, además de los de por defecto. Separados por comas.
ALLOWED_SOURCE_HOSTS=

# URL pública de la app (se usa en los enlaces de recuperación de contraseña).
APP_URL=http://localhost:3000

# Detrás de un proxy inverso (nginx, Caddy, etc.) pon 1 para leer la IP real en X-Forwarded-For.
TRUST_PROXY=0

# Muestra en pantalla el enlace de recuperación (solo para desarrollo, sin servicio de correo).
# Por defecto: 1 fuera de producción, 0 en producción.
# SHOW_RESET_LINK=1

# Cargar el catálogo inicial de ejemplo al arrancar con la base vacía (0 para desactivarlo).
# SEED_CATALOG=1

# Carpeta de datos (base SQLite, secreto JWT y archivos subidos). Por defecto ./data
# DATA_DIR=./data
